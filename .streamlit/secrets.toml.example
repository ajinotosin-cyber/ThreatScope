# Template for Streamlit Cloud secrets. Copy the KEYS (not real values) into
# your app's Settings -> Secrets in the Streamlit Cloud dashboard.
# Do not commit a real .streamlit/secrets.toml file.

VIRUSTOTAL_API_KEY = "your_virustotal_key_here"
ABUSEIPDB_API_KEY = "your_abuseipdb_key_here"
OTX_API_KEY = "optional_otx_key_here"
